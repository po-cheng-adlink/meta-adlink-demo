-	delta = (int)timespec_sub_to_nsec(&now, &ts);
-	if (delta > 1500000)
-		ts = now;
-
-	weston_output_finish_frame(&output->base, &ts, 0);
+	weston_output_finish_frame_from_timer(&output->base);
 
 	return 1;
 }
